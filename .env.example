# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# RabbitMQ application connection
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=city-group.events
CONSUMER_PREFETCH=10

# RabbitMQ Docker container credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Consumer retry policy
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=City Group Members

# Brevo
BREVO_API_KEY=

# Supabase
SUPABASE_URL=
# Recommended for current Supabase projects.
SUPABASE_SECRET_KEY=
# Legacy compatibility. SUPABASE_SECRET_KEY takes precedence when both are set.
SUPABASE_SERVICE_ROLE_KEY=
