{
  "name": "4ward-city-group-integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:producer": "tsx watch producer/src/index.ts",
    "dev:airtable": "tsx watch consumers/airtable/src/index.ts",
    "dev:brevo": "tsx watch consumers/brevo/src/index.ts",
    "dev:supabase": "tsx watch consumers/supabase/src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.2",
    "amqplib": "2.4.1",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/amqplib": "0.10.8",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "4.1.12"
  }
}
